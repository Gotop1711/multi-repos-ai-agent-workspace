#!/usr/bin/env bash
# Enable once per clone:  git config core.hooksPath .githooks
# Note: check inspects the WORKING TREE, not the index — keep them in sync at
# closeout; the binary / size gates below inspect the index.
./workspace.sh check || exit 1
# Text only, ever — with one exception: history is never rewritten, so one binary would be permanent.
# Document originals stay in gitignored docs/assets/; their text goes to docs/<product>/[<repo>/]sources/ via `workspace.sh ingest`,
# and so do the pictures of image pages, sources/<name>.p<N>.jpg, at most 200 KiB each — the only binary this repository keeps.
git diff --cached --numstat | awk -F'\t' '$1=="-" && $3 !~ /^docs\/[^\/]+\/([^\/]+\/)?sources\/[^\/]+\.p[0-9]+\.jpg$/ { print "FAIL: binary staged: " $3 " — originals belong in docs/assets/ (gitignored), not in git"; bad=1 } END { exit bad }' || exit 1
git diff --cached --name-only --diff-filter=ACMR -z -- 'docs/*/sources/*.jpg' 'docs/*/*/sources/*.jpg' | while IFS= read -r -d '' f; do
  [ "$(git cat-file -s ":$f")" -le 204800 ] || { echo "FAIL: $f is over 200 KiB — a picture derivative is capped; re-extract the original"; exit 1; }
done || exit 1
git diff --cached --name-only --diff-filter=ACMR -z | while IFS= read -r -d '' f; do
  [ "$(git cat-file -s ":$f")" -le 1048576 ] || { echo "FAIL: $f is over 1 MiB — too big for this repo; store it as an original"; exit 1; }
done || exit 1
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --no-banner 2>/dev/null || gitleaks protect --staged --no-banner || exit 1
fi
