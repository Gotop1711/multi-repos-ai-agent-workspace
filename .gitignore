# Product layer — never tracked by the workspace repo
/projects/

# Document originals — copied in by `workspace.sh ingest`, never committed (their text lives in docs/<scope>/sources/)
/docs/assets/

# Disposable working artifacts — safe to delete anytime
/.agents/scratch/
.DS_Store

# Secrets and local runtime state — never committed
.env*
*.pem
*.key
credentials*
.claude/settings.local.json
.mcp.json
